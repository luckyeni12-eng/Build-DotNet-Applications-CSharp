@model MvcMovie.Models.MovieGenreViewModel

@{
    ViewData["Title"] = "My Favorite Movies";
}

<div class="d-flex flex-column
            flex-md-row
            justify-content-between
            align-items-md-center
            gap-3 mb-4">

    <div>

        <h1>My Favorite Movies</h1>

        <p class="text-muted mb-0">
            Browse, search, and manage the movies
            in my collection.
        </p>

    </div>

    <a asp-action="Create"
       class="btn btn-primary">
        Add New Movie
    </a>

</div>

<div class="search-card mb-4">

    <form asp-controller="Movies"
          asp-action="Index"
          method="get">

        <div class="row g-3 align-items-end">

            <div class="col-md-3">

                <label asp-for="MovieGenre"
                       class="form-label fw-semibold">
                    Genre
                </label>

                <select asp-for="MovieGenre"
                        asp-items="Model.Genres"
                        class="form-select">

                    <option value="">
                        All Genres
                    </option>

                </select>

            </div>

            <div class="col-md-3">

                <label asp-for="SearchString"
                       class="form-label fw-semibold">
                    Movie Title
                </label>

                <input asp-for="SearchString"
                       class="form-control"
                       placeholder="Search title..." />

            </div>

            <div class="col-md-3">

                <label asp-for="Year"
                       class="form-label fw-semibold">
                    Released Year or Newer
                </label>

                <input asp-for="Year"
                       type="number"
                       class="form-control"
                       min="1888"
                       max="2100"
                       placeholder="Example: 2010" />

            </div>

            <div class="col-md-3">

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-success">
                        Search
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Clear
                    </a>

                </div>

            </div>

        </div>

    </form>

</div>

@if (Model.Year.HasValue)
{
    <div class="alert alert-info">

        Showing movies released in
        <strong>@Model.Year</strong>
        or newer.

    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.SearchString))
{
    <div class="alert alert-light border">

        Searching for:
        <strong>@Model.SearchString</strong>

    </div>
}

@if (!Model.Movies.Any())
{
    <div class="alert alert-warning">

        No movies matched your search.

    </div>
}
else
{
    <div class="table-responsive">

        <table class="table table-striped
                      table-hover align-middle">

            <thead>

                <tr>

                    <th>
                        @Html.DisplayNameFor(
                            model => model.Movies[0].Title)
                    </th>

                    <th>
                        @Html.DisplayNameFor(
                            model => model.Movies[0].ReleaseDate)
                    </th>

                    <th>
                        @Html.DisplayNameFor(
                            model => model.Movies[0].Genre)
                    </th>

                    <th>
                        @Html.DisplayNameFor(
                            model => model.Movies[0].Price)
                    </th>

                    <th>
                        @Html.DisplayNameFor(
                            model => model.Movies[0].Rating)
                    </th>

                    <th>
                        Actions
                    </th>

                </tr>

            </thead>

            <tbody>

                @foreach (var item in Model.Movies)
                {
                    <tr>

                        <td>
                            @Html.DisplayFor(
                                modelItem => item.Title)
                        </td>

                        <td>
                            @Html.DisplayFor(
                                modelItem => item.ReleaseDate)
                        </td>

                        <td>
                            @Html.DisplayFor(
                                modelItem => item.Genre)
                        </td>

                        <td>
                            @Html.DisplayFor(
                                modelItem => item.Price)
                        </td>

                        <td>
                            @Html.DisplayFor(
                                modelItem => item.Rating)
                        </td>

                        <td class="text-nowrap">

                            <a asp-action="Edit"
                               asp-route-id="@item.Id">
                                Edit
                            </a>

                            |

                            <a asp-action="Details"
                               asp-route-id="@item.Id">
                                Details
                            </a>

                            |

                            <a asp-action="Delete"
                               asp-route-id="@item.Id">
                                Delete
                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
}